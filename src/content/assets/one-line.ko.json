    }
  },
  {
    "id": "ko-saying-proverb-02",
    "title": "한국 격언·속담",
    "text": "낮말은 새가 듣고 밤말은 쥐가 듣는다",
    "source": "traditional",
    "credit": {
      "author": "구전",
      "source": "위키낱말사전 · 한국어 속담",
